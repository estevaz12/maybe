<%# locals: (planner:, planning_setting: nil) %>
<% other_root = monthly_planning_other_root(planning_setting) %>

<div class="space-y-6">
  <div>
    <p class="text-sm text-secondary">Estimated total for next month</p>
    <p class="mt-1 text-3xl font-semibold text-primary tabular-nums tracking-tight">
      <%= Money.new(planner.combined_need_domestic, Current.family.currency).format %>
    </p>
    <% if planning_setting&.run_rate_root && other_root %>
      <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-secondary">
        <span class="text-secondary">From</span>
        <%= render "categories/badge", category: planning_setting.run_rate_root %>
        <span class="text-secondary">+</span>
        <%= render "categories/badge", category: other_root %>
        <span class="text-secondary">(other amount is manual)</span>
      </div>
    <% end %>
  </div>

  <% if planner.uses_line_breakdown && planner.run_rate_line_items.any? %>
    <% cats = Current.family.categories.where(id: planner.run_rate_line_items.map(&:category_id)).index_by { |c| c.id.to_s } %>
    <div class="space-y-2">
      <p class="text-xs font-medium text-secondary uppercase tracking-wide">Pace group</p>
      <div class="divide-y divide-primary/40">
        <% planner.run_rate_line_items.each do |item| %>
          <% cat = cats[item.category_id.to_s] || cats[item.category_id] %>
          <div class="flex flex-wrap items-center justify-between gap-2 py-2.5 min-w-0">
            <div class="min-w-0 flex items-center gap-2 [&>div]:inline-flex">
              <% if cat %>
                <%= render "categories/badge", category: cat %>
              <% else %>
                <span class="text-sm font-medium text-primary truncate"><%= item.category_name %></span>
              <% end %>
              <span class="text-xs text-secondary hidden sm:inline">
                <% if item.mode == :manual %>
                  Fixed
                <% else %>
                  Pace
                <% end %>
              </span>
            </div>
            <span class="text-sm font-medium text-primary tabular-nums shrink-0">
              <%= Money.new(item.projected_amount, Current.family.currency).format %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if planner.simple_fx_amount_target_currency %>
    <div class="pt-2">
      <p class="text-xs text-secondary">Converted (your rate)</p>
      <p class="text-xl font-semibold text-primary tabular-nums mt-0.5">
        <%= planner.simple_fx_amount_target_currency.round(2) %>
      </p>
    </div>
  <% end %>

  <% if planner.tiered_breakdown %>
    <div class="flex flex-wrap gap-6 text-sm">
      <div>
        <p class="text-xs text-secondary">First tier USD</p>
        <p class="font-medium text-primary tabular-nums mt-0.5"><%= planner.tiered_breakdown[:first_usd].round(2) %></p>
      </div>
      <div>
        <p class="text-xs text-secondary">Second tier USD</p>
        <p class="font-medium text-primary tabular-nums mt-0.5"><%= planner.tiered_breakdown[:second_usd].round(2) %></p>
      </div>
    </div>
  <% end %>

  <details class="group text-sm">
    <summary class="cursor-pointer list-none inline-flex items-center gap-1.5 text-secondary hover:text-primary">
      <%= icon "chevron-down", size: "sm", class: "group-open:rotate-180 transition-transform" %>
      How this number is calculated
    </summary>
    <div class="mt-3 pl-1 border-l border-primary/40 space-y-2 text-sm">
      <div class="flex justify-between gap-4">
        <span class="text-secondary">Days in <%= planner.reference_month.strftime("%B %Y") %></span>
        <span class="tabular-nums text-primary font-medium"><%= planner.days_in_reference_month %></span>
      </div>
      <% if planner.uses_line_breakdown %>
        <div class="flex justify-between gap-4">
          <span class="text-secondary">Pace divisor days</span>
          <span class="tabular-nums text-primary font-medium"><%= planner.pace_reference_days %></span>
        </div>
      <% end %>
      <div class="flex justify-between gap-4">
        <span class="text-secondary">Days in <%= planner.next_month.strftime("%B %Y") %></span>
        <span class="tabular-nums text-primary font-medium"><%= planner.days_in_next_month %></span>
      </div>
      <% if planner.run_rate_days_next_month != planner.days_in_next_month %>
        <div class="flex justify-between gap-4">
          <span class="text-secondary">Days remaining (pace)</span>
          <span class="tabular-nums text-primary font-medium"><%= planner.run_rate_days_next_month %></span>
        </div>
      <% end %>
      <div class="flex justify-between gap-4">
        <span class="text-secondary">Inflation (×)</span>
        <span class="tabular-nums text-primary font-medium"><%= planner.inflation_multiplier.round(4) %></span>
      </div>
      <div class="flex justify-between gap-4">
        <span class="text-secondary">Pace group projected</span>
        <span class="tabular-nums text-primary font-medium"><%= Money.new(planner.projected_run_rate_spend, Current.family.currency).format %></span>
      </div>
      <% if planner.previous_month_surplus.positive? %>
        <div class="flex justify-between gap-4">
          <span class="text-secondary">Surplus</span>
          <span class="tabular-nums text-primary font-medium">−<%= Money.new(planner.previous_month_surplus, Current.family.currency).format %></span>
        </div>
      <% end %>
      <div class="flex justify-between gap-4">
        <span class="text-secondary">Other group (manual)</span>
        <span class="tabular-nums text-primary font-medium"><%= Money.new(planner.spent_other_root, Current.family.currency).format %></span>
      </div>
    </div>
  </details>
</div>
