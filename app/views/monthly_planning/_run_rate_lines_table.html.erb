<%# locals: (lines:, planning_params:, planning_setting:, reference_days:) %>
<% run_root = planning_setting.run_rate_root %>
<% return unless run_root && lines.any? %>
<% categories_by_id = Current.family.categories.where(id: lines.map(&:category_id)).index_by(&:id) %>

<div class="space-y-3">
  <div class="flex flex-wrap items-center gap-2">
    <%= render "categories/badge", category: run_root %>
    <span class="text-sm text-secondary">Pace group — <%= reference_days %> day period</span>
  </div>
  <p class="text-xs text-secondary leading-relaxed max-w-2xl">
    Blank inflation uses the default % below. “Use fixed amount” skips pace for that category.
  </p>

  <div class="space-y-0 divide-y divide-primary/40">
    <% lines.each do |line| %>
      <% cid = line.category_id %>
      <% category = categories_by_id[cid] %>
      <% rp = planning_params[:run_rate] || {} %>
      <% row = rp[cid.to_s] || rp[cid] || {} %>
      <% manual_on = ActiveModel::Type::Boolean.new.cast(row["manual"] || row[:manual]) %>
      <div class="py-3 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-end" data-controller="run-rate-manual-row" data-action="change->run-rate-manual-row#sync">
        <div class="min-w-0 flex items-center [&>div]:inline-flex">
          <% if category %>
            <%= render "categories/badge", category: category %>
          <% else %>
            <span class="text-sm font-medium text-primary truncate"><%= line.category_name %></span>
          <% end %>
        </div>
        <div class="text-sm tabular-nums text-secondary sm:text-right">
          <%= Money.new(line.total, Current.family.currency).format %>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-end">
          <label class="inline-flex items-center gap-2 cursor-pointer shrink-0">
            <%= hidden_field_tag "planning[run_rate][#{cid}][manual]", "0", id: nil %>
            <%= check_box_tag "planning[run_rate][#{cid}][manual]", "1", manual_on, class: "rounded border-primary shrink-0", data: { run_rate_manual_row_target: "checkbox" } %>
            <span class="text-xs text-secondary whitespace-nowrap">Fixed amount</span>
          </label>
          <%= number_field_tag "planning[run_rate][#{cid}][manual_amount]", row["manual_amount"] || row[:manual_amount], step: "any", autocomplete: "off", placeholder: "Amount", class: "w-full min-w-[6rem] border border-primary rounded-lg bg-container px-2 py-1.5 text-primary text-sm sm:max-w-[9rem] #{'opacity-50' unless manual_on}", data: { run_rate_manual_row_target: "amount" }, readonly: !manual_on %>
        </div>
      </div>
    <% end %>
  </div>
</div>
