<% title "#{@snapshot.reference_month.strftime('%B %Y')} snapshot" %>

<div class="max-w-3xl mx-auto space-y-8 pb-16 px-3">
  <header class="space-y-3">
    <%= link_to monthly_planning_path(Budget.date_to_param(@snapshot.reference_month)), class: "inline-flex items-center gap-1 text-sm text-link" do %>
      <%= icon "chevron-left", size: "sm" %>
      Plan next month
    <% end %>
    <div>
      <h1 class="text-2xl font-medium text-primary"><%= @snapshot.reference_month.strftime("%B %Y") %> snapshot</h1>
      <p class="text-sm text-secondary mt-1">
        Saved <%= @snapshot.created_at.strftime("%b %-d, %Y · %H:%M") %>
      </p>
    </div>
  </header>

  <section class="rounded-xl border border-primary bg-container p-5 space-y-4">
    <h2 class="text-lg font-medium text-primary">Inputs</h2>
    <%= render "monthly_planning/snapshot_inputs", inputs: @snapshot.inputs %>
  </section>

  <% if @snapshot.outputs.present? %>
    <% ins = (@snapshot.inputs || {}).stringify_keys %>
    <% snapshot_setting = FamilyMonthlyPlanningSetting.new(
         family: Current.family,
         first_root_category_id: ins["first_root_category_id"],
         second_root_category_id: ins["second_root_category_id"],
         run_rate_root_category_id: ins["run_rate_root_category_id"]
       ) %>
    <section class="rounded-xl border border-primary bg-container p-5 space-y-4">
      <h2 class="text-lg font-medium text-primary">Estimate at save time</h2>
      <%= render "projection_results",
            planner: MonthlyPlanning::SnapshotPlannerView.new(@snapshot),
            planning_setting: snapshot_setting %>
    </section>
  <% else %>
    <section class="rounded-xl border border-primary bg-container p-5">
      <p class="text-sm text-secondary">No projection outputs were stored for this snapshot.</p>
    </section>
  <% end %>
</div>
